<?xml version="1.0" encoding="utf-8"?>
<!--
    Versão "vidro": em vez de um corpo opaco colorido, o botão principal
    agora é translúcido — o fundo em gradiente do widget aparece por trás,
    e as camadas de sombra/brilho por cima é que dão a sensação de volume
    3D, como um botão de vidro fosco flutuando sobre o wallpaper.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="4dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <solid android:color="#4D000000" />
        </shape>
    </item>

    <item android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:centerColor="#26FFFFFF"
                android:endColor="#14FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>

    <item
        android:top="6dp"
        android:left="14dp"
        android:right="14dp"
        android:bottom="34dp">
        <shape android:shape="oval">
            <solid android:color="#4DFFFFFF" />
        </shape>
    </item>

</layer-list>
