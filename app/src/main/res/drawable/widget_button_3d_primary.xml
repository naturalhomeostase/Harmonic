<?xml version="1.0" encoding="utf-8"?>
<!-- Mesma estrutura de widget_button_3d, só que maior e com um leve tom
     quente (combina com a cor de destaque padrão do app), pra marcar o
     botão de play/pause como o principal do grupo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="4dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <solid android:color="#59000000" />
        </shape>
    </item>

    <item android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F2FFB74D"
                android:centerColor="#E6EF6C00"
                android:endColor="#CCB35400" />
            <stroke
                android:width="1dp"
                android:color="#66FFE0B2" />
        </shape>
    </item>

    <item
        android:top="6dp"
        android:left="14dp"
        android:right="14dp"
        android:bottom="34dp">
        <shape android:shape="oval">
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>

</layer-list>
