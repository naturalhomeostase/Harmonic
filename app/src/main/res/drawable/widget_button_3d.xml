<?xml version="1.0" encoding="utf-8"?>
<!--
    Botão "físico": três camadas empilhadas simulam profundidade real:
    1) sombra por baixo, deslocada — o botão parece flutuar acima do widget
    2) corpo do botão com gradiente diagonal (mais claro em cima, mais
       escuro embaixo) + borda sutil — dá volume à esfera/pílula
    3) reflexo superior (highlight), um oval bem claro perto do topo — o
       "brilho" que um botão físico real refletiria de uma luz vindo de cima
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="3dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <solid android:color="#4D000000" />
        </shape>
    </item>

    <item android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:centerColor="#3DFFFFFF"
                android:endColor="#14FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>

    <item
        android:top="4dp"
        android:left="10dp"
        android:right="10dp"
        android:bottom="26dp">
        <shape android:shape="oval">
            <solid android:color="#4DFFFFFF" />
        </shape>
    </item>

</layer-list>
